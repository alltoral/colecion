{
  // Coleção Neon no Cloudflare Workers: app estático + IA (Workers AI)
  "name": "colecion",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // nuvem da coleção: um Durable Object (SQLite) por código de coleção
  "durable_objects": {
    "bindings": [{ "name": "COLECAO", "class_name": "Colecao" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Colecao"] }],
  "observability": {
    "enabled": true
  }
}
